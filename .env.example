# Copy to .env.local and fill in. Never commit real keys.
# Browser-safe (the publishable key is meant to be public; RLS protects data)
NEXT_PUBLIC_SUPABASE_URL=https://gszugepvhtdrldgdqzvi.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Google Maps Platform key (Map Tiles API + Places API (New) enabled). Used in the browser for the
# photorealistic 3D tiles, so restrict it to those two APIs (and your site's address) in Google Cloud.
NEXT_PUBLIC_GOOGLE_MAPS_KEY=

# Server-only (no NEXT_PUBLIC_ prefix!)
MBTA_API_KEY=
TIGER_DATA_URL=postgres://tsdbadmin:PASSWORD@HOST:PORT/tsdb?sslmode=require
GEMINI_API_KEY=
