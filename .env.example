# Copy to .env.local and fill in. Never commit real keys.
# Browser-safe (Supabase anon key is meant to be public; RLS protects data)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only (no NEXT_PUBLIC_ prefix!)
MBTA_API_KEY=
TIGER_DATA_URL=postgres://tsdbadmin:PASSWORD@HOST:PORT/tsdb?sslmode=require
GEMINI_API_KEY=
