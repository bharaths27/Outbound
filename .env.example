# Copy to .env.local and fill in. Never commit real keys.
# Browser-safe (the publishable key is meant to be public; RLS protects data)
NEXT_PUBLIC_SUPABASE_URL=https://gszugepvhtdrldgdqzvi.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Google Maps Platform key (Map Tiles API + Places API (New) enabled). Used in the browser for the
# photorealistic 3D tiles, so restrict it to those two APIs (and your site's address) in Google Cloud.
NEXT_PUBLIC_GOOGLE_MAPS_KEY=

# Server-only (no NEXT_PUBLIC_ prefix!)
MBTA_API_KEY=
TIGER_DATA_URL=postgres://tsdbadmin:PASSWORD@HOST:PORT/tsdb?sslmode=require
GEMINI_API_KEY=
XAI_API_KEY=
# Optional: model for the Mastra trip planner (/api/agent). Uses GEMINI_API_KEY.
MASTRA_MODEL=gemini-2.5-flash

# Only for scripts/seed-demo.mjs on Bharath's laptop. Never add to Vercel or share.
SUPABASE_SECRET_KEY=
DEMO_PASSWORD=

# Frontend data source while backend fills in: mock | supabase
NEXT_PUBLIC_DATA_SOURCE=mock

# Outbound Rewards on Solana devnet. `node scripts/solana-setup.mjs` fills these into .env.local.
# Server-only (copy to Vercel, never NEXT_PUBLIC_): SOLANA_SECRET_KEY, REWARDS_SECRET
SOLANA_SECRET_KEY=
REWARDS_SECRET=
# Public (the OUT token's address)
NEXT_PUBLIC_OUT_MINT=
